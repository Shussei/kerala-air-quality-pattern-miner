# Kerala Air Quality Pattern Miner - local secrets
# Copy this file to .env and fill in values. Never commit .env.

# OpenAQ API v3 requires an API key. Obtain one at https://openaq.org/
# Leave unset to disable automated OpenAQ ingestion (CSV upload remains available).
OPENAQ_API_KEY=

# NASA POWER API (meteorological/weather data). No key required for the public API,
# but a token can be set if you have registered one.
NASA_POWER_API_KEY=

# Default timezone used for date parsing (IANA name)
DEFAULT_TIMEZONE=Asia/Kolkata

# Base directory for data outputs (absolute path recommended)
DATA_DIR=./data
